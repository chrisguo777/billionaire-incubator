# 复制本文件为 .env.local，填入你自己的 Anthropic API key，再重启 npm run dev。
# .env.local 已被 git 忽略，不要把密钥写入本示例文件。
LLM_PROVIDER=anthropic
LLM_MODE=live
ANTHROPIC_API_KEY=

# 可选：覆盖默认模型（默认 claude-opus-5-5）
# ANTHROPIC_MODEL=

# 可选：即使有 key 也强制使用 mock
# LLM_MODE=mock

# 可选：公司名自动补全（https://logo.dev 免费注册，用 secret key，sk_ 开头，只在服务器端使用）。
# 没有配置时，下拉框用内置的几十家公司。
# LOGO_DEV_SECRET_KEY=
