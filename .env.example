# 复制本文件为 .env.local，填入你自己的 API key，再重启 npm run dev。
# .env.local 已被 git 忽略，不要把密钥写入本示例文件。

# ---------- 方式一：Claude（默认） ----------
LLM_PROVIDER=anthropic
LLM_MODE=live
ANTHROPIC_API_KEY=

# 可选：覆盖默认模型（默认 claude-opus-5-5）
# ANTHROPIC_MODEL=

# ---------- 方式二：任何提供 OpenAI 兼容接口的模型 ----------
# 把上面的 LLM_PROVIDER 改成 openai-compatible，再填写下面三项。
# 提示词和测试都是在 Claude 上调的；其他模型能用，但效果没有评估过。
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
#
# 各家的 LLM_BASE_URL 示例（模型名以各家官网为准）：
#   OpenAI        https://api.openai.com/v1                                   例如 gpt-6.2-sol
#   DeepSeek      https://api.deepseek.com                                    （建议同时设 LLM_JSON_MODE=json_object）
#   豆包（火山方舟） https://ark.cn-beijing.volces.com/api/v3                      模型名填方舟里的模型 ID 或接入点 ID
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai/
#
# 可选：
#   LLM_JSON_MODE=json_object     不支持 json_schema 的模型用这个；默认 json_schema，被拒绝时会自动改用 json_object
#   LLM_MAX_TOKENS=8192           单次输出上限；OpenAI 官方默认 16000，其他默认 8192
#   LLM_MAX_TOKENS_PARAM=         上限参数名；OpenAI 官方默认 max_completion_tokens，其他默认 max_tokens
#   LLM_REASONING_EFFORT=         推理强度（如 low / medium / high），只在模型支持时设置

# ---------- 其他 ----------
# 可选：即使有 key 也强制使用 mock
# LLM_MODE=mock

# 可选：公司名自动补全（https://logo.dev 免费注册，用 secret key，sk_ 开头，只在服务器端使用）。
# 没有配置时，下拉框用内置的几十家公司。
# LOGO_DEV_SECRET_KEY=
